{
  "name": "vergate",
  "version": "0.2.1",
  "description": "Vercel multi-account manager. CLI + library for switching between Vercel identities.",
  "author": "Andre Dezzy",
  "license": "MIT",
  "type": "module",
  "bin": {
    "vergate": "dist/cli.js"
  },
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "bun src/cli.ts",
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "bun run build"
  },
  "keywords": [
    "vercel",
    "cli",
    "multi-account",
    "account-switcher",
    "deploy"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/andredezzy/vergate.git"
  },
  "dependencies": {
    "@clack/prompts": "^0.10.0",
    "citty": "^0.1.0",
    "nanospinner": "^1.2.0",
    "picocolors": "^1.1.1"
  },
  "devDependencies": {
    "@types/bun": "^1.3.5",
    "tsdown": "^0.22.0",
    "typescript": "^5.8.0",
    "unrun": "^0.3.0"
  }
}
